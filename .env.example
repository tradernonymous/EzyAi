TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# When true, market data falls back to a built-in synthetic generator
# whenever live API calls fail (useful for offline demos/tests).
EZYAI_DEMO_DATA=false

# Where watches / autopilot state is persisted.
EZYAI_STATE_FILE=state.json

# Logging level: DEBUG, INFO, WARNING, ERROR
EZYAI_LOG_LEVEL=INFO