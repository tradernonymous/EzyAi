TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# When true, market data falls back to a built-in synthetic generator
# whenever live API calls fail (useful for offline demos/tests).
EZYAI_DEMO_DATA=false

# Where watches / autopilot state is persisted.
EZYAI_STATE_FILE=state.json

# Logging level: DEBUG, INFO, WARNING, ERROR
EZYAI_LOG_LEVEL=INFO

# ---- Monetization ----
# Native Stripe card checkout (dynamic prices, no preset Price IDs).
# Get both from dashboard.stripe.com (Developers -> API keys / Webhooks).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Bot username (no @) for Stripe success/cancel redirects.
BOT_USERNAME=ezytradeai_bot

# USDT (TRC-20) receiving address shown to manual payers.
USDT_ADDRESS=

# Telegram user id that approves/rejects USDT claims (also always-PRO).
ADMIN_TELEGRAM_ID=

# Comma-separated Telegram user ids with permanent PRO (team monitoring).
# Editable anytime via Fly secret, no redeploy needed.
PRO_ACCESS_IDS=